# ESP-IDF build output (regenerated by `idf.py build`, not source)
build/
managed_components/

# menuconfig's backup of the previous sdkconfig
sdkconfig.old

# The generated sdkconfig itself: it's per-board (master/slave role,
# COM port quirks, etc.) and fully regenerable from menuconfig choices
# -- not something to track. If this project later gains an
# sdkconfig.defaults, that file IS meant to be committed (it's the
# template new checkouts start from); only the generated `sdkconfig`
# is excluded here.
sdkconfig

# ESP-IDF Component Manager's lock file. Worth committing once this
# example depends on the tagged git version of the component (pins an
# exact resolved version, real reproducibility value) -- but while it
# still uses a local `path:` dependency, there's no version to pin, so
# the lock file doesn't mean much yet. Revisit this line after
# switching examples/loopback_test/main/idf_component.yml over to the
# git dependency.
dependencies.lock

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
